# Generated .opencode mirrors — created by `npm install` (tools/fix-opencode-symlinks.mjs).
# Never commit these: git can only store them as symlinks, and a Windows checkout
# without Developer Mode materialises them as junctions, which git reads as a
# deleted symlink. See docs/tooling/opencode-symlink-conflict.md.
/.opencode/agents
/.opencode/commands
/.opencode/rules
/.opencode/skills

# Session data (private — contains design discussions)
production/session-logs/
production/session-state/

# Superpowers SDK design docs (not part of OCGS)
.superpowers/
docs/superpowers/
/framework/

# Git worktrees
.worktrees/

# Claude Code per-user files (shared config is .claude/settings.json)
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# OS junk
Thumbs.db
.DS_Store
desktop.ini
*.swp
*.swo
*~
tests/agents/validation-report.md

# Coding-agent session transcripts accidentally dropped at repo root
omp-session-*.html

# Submodule dependencies
tools/aseprite-mcp/.venv/

# Local staging for downloaded assets and tool copies (never commit)
/inbox/

# Local Godot binaries (large; install separately)
/Godot_v*.exe
/Godot_v*.zip
