{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(python -m json.tool *)",
      "Bash(python -m pytest *)",
      "Bash(py -m pytest *)",
      "Bash(npm test)",
      "Bash(npm run test*)",
      "Bash(npm run claude:check)",
      "Bash(npm run claude:sync)",
      "Bash(node tests/agents/validate.mjs *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -*f*)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.godot/**)",
      "Read(**/*.import)",
      "Read(**/*.uid)",
      "Read(**/node_modules/**)",
      "Read(**/*.glb)",
      "Read(**/*.gltf)",
      "Read(**/*.blend)",
      "Read(**/*.fbx)",
      "Read(**/*.wav)",
      "Read(**/*.ogg)",
      "Read(**/*.mp3)",
      "Read(**/*.mp4)",
      "Read(**/*.webm)",
      "Read(**/*.ttf)",
      "Read(**/*.otf)",
      "Edit(**/*.import)",
      "Edit(**/*.uid)"
    ],
    "ask": [
      "mcp__hyper3d__rodin_generate*",
      "mcp__blender__generate_3d"
    ]
  },
  "skillOverrides": {
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:computer-use": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/ocgs-hooks.mjs",
              "session-start"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/ocgs-hooks.mjs",
              "pre-compact"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/ocgs-hooks.mjs",
              "session-end"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/ocgs-hooks.mjs",
              "pre-tool-use"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/ocgs-hooks.mjs",
              "post-tool-use"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
