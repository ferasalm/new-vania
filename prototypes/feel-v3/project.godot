; PROTOTYPE - NOT FOR PRODUCTION
; Question: does the hero feel good to move and fight with?
; Date: 2026-11-16 (v3, stage 1)

config_version=5

[application]

config/name="New Vania - Feel v3"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

T="*res://tuning.gd"
G="*res://game.gd"
Sfx="*res://audio.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.086, 0.078, 0.133, 1)
