#!/bin/sh
# After a branch switch: restore .agents files removed through the .opencode junctions
# and regenerate the links. $3 is 1 for a branch checkout, 0 for a file checkout.
[ "$3" = "1" ] || exit 0
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
command -v node >/dev/null 2>&1 || exit 0
node "$root/tools/git-hooks/post-checkout.mjs" || true
